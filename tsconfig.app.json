{
    "compilerOptions": {
        "paths": {
            "@bot/*": ["${configDir}/bot/*"],
            "@lib/*": ["${configDir}/lib/*"],
            "@src/*": ["${configDir}/src/*"]
        },
        "types": ["node"]
    },
    "exclude": [
        ".vitest/",
        "coverage/",
        "dist/",
        "node_modules/",
        "**/*.test.ts"
    ],
    "extends": "./tsconfig.base.json",
    "include": ["bot/**/*.ts", "lib/**/*.ts", "src/**/*.ts"]
}
