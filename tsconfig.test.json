{
    "compilerOptions": {
        "paths": {
            "@bot/*": ["${configDir}/bot/*"],
            "@lib/*": ["${configDir}/lib/*"],
            "@src/*": ["${configDir}/src/*"]
        },
        "types": ["node"]
    },
    "exclude": ["coverage/", "dist/", "html/", "node_modules/"],
    "extends": "./tsconfig.base.json",
    "include": ["**/*.test.ts", "bot/**/*.ts", "lib/**/*.ts", "src/**/*.ts"]
}
